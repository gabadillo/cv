% a left item (wraps freely) with a right-hand item anchored top-right, never pushed left
\newcommand{\tworow}[2]{%
  \begin{tabularx}{\linewidth}{@{}X r@{}}
  #1 & #2 \\
  \end{tabularx}%
}

% same, but the right-hand item is styled as a bold, accent-colored, non-breaking date/label
\newcommand{\daterow}[2]{%
  \tworow{#1}{\mbox{\textbf{\textcolor{accent}{#2}}}}%
}

\newcommand{\entry}[3]{%
  \daterow{\textbf{#1}}{#2}
  \textit{#3}\par\vspace{0.35em}
}

% #1 institution (big title)  #2 location  #3 role/degree  #4 dates  #5 supervisor/advisor
\newcommand{\bigentry}[5]{%
  \daterow{{\large\bfseries #1}}{#2}
  \daterow{\textit{#3}}{#4}
  {\small\itshape #5}\par\vspace{0.3em}
}

% #1 degree+field (big title)  #2 dates
\newcommand{\eduentry}[2]{%
  \daterow{{\large\bfseries #1}}{#2}
  \vspace{0.05em}
}

